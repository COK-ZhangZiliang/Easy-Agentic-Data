{
  "run_name": "deepseek-v4-flash-thinking-demo",
  "random_seed": 42,
  "llm": {
    "provider": "openai_compatible",
    "model": "deepseek-v4-flash",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "chat_completions_path": "/chat/completions",
    "timeout_seconds": 180,
    "temperature": 0.0,
    "max_tokens": 8192,
    "max_retries": 2,
    "retry_backoff_seconds": 1.0,
    "request_body": {
      "thinking": {
        "type": "enabled"
      },
      "reasoning_effort": "high"
    }
  },
  "generation": {
    "num_tasks": 1,
    "rollouts_per_task": 1,
    "max_turns": 10,
    "min_reward": 0.7,
    "seed_topics": [
      "software engineering"
    ],
    "evolve_rounds": 0
  },
  "output": {
    "directory": "runs/deepseek-v4-flash-thinking-demo",
    "export_sft": true,
    "export_preferences": true
  }
}
