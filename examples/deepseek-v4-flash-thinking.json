{
  "llm": {
    "provider": "openai_compatible",
    "model": "deepseek-v4-flash",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "chat_completions_path": "/chat/completions",
    "timeout_seconds": 180,
    "temperature": 0.0,
    "max_tokens": 8192,
    "max_retries": 2,
    "retry_backoff_seconds": 1.0,
    "request_body": {
      "thinking": {
        "type": "enabled"
      },
      "reasoning_effort": "high"
    }
  }
}
