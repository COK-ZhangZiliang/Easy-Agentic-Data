{
  "llm": {
    "provider": "openai_compatible",
    "model": "YOUR_MODEL_NAME",
    "base_url": "https://api.openai.com/v1",
    "api_key_env": "OPENAI_API_KEY",
    "chat_completions_path": "/chat/completions",
    "timeout_seconds": 60,
    "temperature": 0.7,
    "max_tokens": 2048,
    "max_retries": 2,
    "retry_backoff_seconds": 1.0,
    "request_body": {}
  }
}
