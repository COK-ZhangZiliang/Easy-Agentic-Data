{
  "run_name": "deepseek-v4-flash-demo",
  "random_seed": 42,
  "llm": {
    "provider": "openai_compatible",
    "model": "deepseek-v4-flash",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "chat_completions_path": "/chat/completions",
    "timeout_seconds": 120,
    "temperature": 0.7,
    "max_tokens": 2048,
    "max_retries": 2,
    "retry_backoff_seconds": 1.0,
    "request_body": {
      "thinking": {
        "type": "disabled"
      }
    }
  },
  "generation": {
    "num_tasks": 3,
    "rollouts_per_task": 2,
    "max_turns": 6,
    "min_reward": 0.7,
    "seed_topics": [
      "calculation",
      "tool use"
    ],
    "evolve_rounds": 1
  },
  "output": {
    "directory": "runs/deepseek-v4-flash-demo",
    "export_sft": true,
    "export_preferences": true
  }
}
